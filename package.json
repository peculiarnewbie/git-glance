{
  "name": "git-glance",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "dev:ui": "pnpm --filter @git-glance/desktop dev",
    "dev:server-go": "go run ./packages/server-go",
    "dev:server-bun": "bun run ./packages/server-bun/main.ts",
    "dev:local": "concurrently -n agent,vite \"go run -C packages/agent . --local\" \"pnpm dev:ui\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "packageManager": "pnpm@11.5.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
